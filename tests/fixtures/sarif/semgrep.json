{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "semanticVersion": "1.75.0",
          "informationUri": "https://semgrep.dev",
          "rules": [
            {
              "id": "python.lang.security.audit.dangerous-subprocess-use",
              "name": "dangerous-subprocess-use",
              "shortDescription": { "text": "Detected subprocess function with user input" },
              "fullDescription": { "text": "Audit the use of subprocess with untrusted input." },
              "help": {
                "text": "Use shlex.quote or pass a list of arguments.",
                "markdown": "Use `shlex.quote` or pass a list of arguments."
              },
              "helpUri": "https://semgrep.dev/r/python.lang.security.audit.dangerous-subprocess-use",
              "defaultConfiguration": { "level": "warning" },
              "properties": {
                "tags": ["security", "external/cwe/cwe-078"],
                "precision": "very-high",
                "security-severity": "8.6"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.lang.security.audit.dangerous-subprocess-use",
