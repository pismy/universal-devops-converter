{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Istanbul coverage map (coverage-final.json)",
  "description": "Written by this project: istanbul-lib-coverage defines the shape in code (its _coverageSchema hash) and publishes no JSON Schema. This describes what nyc and Jest's json reporter emit. Strict about the structure that matters — the counter maps and the position ranges — and permissive about the extras different versions add.",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "type": "object",
    "required": ["statementMap", "s"],
    "properties": {
      "path": { "type": "string", "minLength": 1 },
      "statementMap": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/range" }
      },
      "fnMap": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "decl": { "$ref": "#/$defs/range" },
            "loc": { "$ref": "#/$defs/range" },
            "line": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "branchMap": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "line": { "type": "integer", "minimum": 0 },
            "loc": { "$ref": "#/$defs/range" },
            "locations": { "type": "array", "items": { "$ref": "#/$defs/range" } }
          }
        }
      },
      "s": {
        "type": "object",
        "additionalProperties": { "type": "integer", "minimum": 0 }
      },
      "f": {
        "type": "object",
        "additionalProperties": { "type": "integer", "minimum": 0 }
      },
      "b": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        }
      },
      "_coverageSchema": { "type": "string" },
      "hash": { "type": "string" },
      "contentHash": { "type": "string" },
      "inputSourceMap": { "type": ["object", "null"] },
      "all": { "type": "boolean" }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      }
    },
    "position": {
      "type": "object",
      "properties": {
        "line": { "type": ["integer", "null"], "minimum": 0 },
        "column": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
